---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const articles = allArticles
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .map(a => ({
    category: a.data.category,
    title: a.data.title,
    excerpt: a.data.excerpt,
    date: a.data.date,
    img: a.data.eyecatch,
    href: `/articles/${a.id}`,
  }));
---
<BaseLayout title="reframe magazine — 映画・ドラマの考察メディア" activeNav="home">
  <style is:global>
    .site-main { max-width: 1000px; margin: 0 auto; padding: 0 40px; }
    a { color: inherit; text-decoration: none; }

    /* Hero */
    .hero-section { border: 1px solid var(--border); margin: 32px 0 48px; position: relative; overflow: hidden; cursor: pointer; }
    .hero-section:hover .hero-img-placeholder { transform: scale(1.02); }
    .hero-inner { display: grid; grid-template-columns: 1fr 1fr; min-height: 360px; }
    .hero-label-vertical { position: absolute; left: 0; top: 0; bottom: 0; width: 40px; display: flex; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid var(--border); z-index: 2; }
    .hero-label-text { writing-mode: vertical-rl; text-orientation: mixed; font-family: var(--sans); font-size: 9px; letter-spacing: 0.3em; color: var(--fg-light); transform: rotate(180deg); white-space: nowrap; }
    .hero-label-line { width: 1px; height: 40px; background: var(--border); margin-top: 10px; }
    .hero-label-num { font-family: var(--serif); font-size: 11px; color: var(--fg-light); margin-top: 8px; }
    .hero-image { position: relative; overflow: hidden; min-height: 360px; }
    .hero-img-placeholder { width: 100%; height: 100%; min-height: 360px; background: repeating-linear-gradient(-45deg, #2a2826 0px, #2a2826 1px, #1c1b19 1px, #1c1b19 8px); display: flex; align-items: flex-end; justify-content: flex-start; padding: 16px; transition: transform 0.5s ease; }
    .hero-img-placeholder span { font-size: 9px; font-family: monospace; color: #888; letter-spacing: 0.05em; }
    .hero-text { padding: 48px 40px 40px 56px; display: flex; flex-direction: column; justify-content: space-between; }
    .hero-category { font-size: 10px; letter-spacing: 0.12em; color: var(--fg-light); margin-bottom: 16px; }
    .hero-title { font-family: var(--serif); font-size: 26px; font-weight: 500; line-height: 1.55; color: var(--fg); letter-spacing: 0.01em; flex: 1; display: flex; align-items: center; }
    .hero-excerpt { font-size: 12px; color: var(--fg-mid); line-height: 1.9; margin-top: 16px; margin-bottom: 24px; }
    .hero-meta { display: flex; align-items: center; justify-content: space-between; }
    .hero-date { font-size: 11px; color: var(--fg-light); letter-spacing: 0.04em; }
    .hero-dots { display: flex; gap: 6px; }
    .hero-dot { width: 6px; height: 6px; border-radius: 50%; border: 1px solid var(--border); background: none; cursor: pointer; padding: 0; transition: background 0.2s; }
    .hero-dot.active { background: var(--fg); border-color: var(--fg); }
    .hero-nav { display: flex; gap: 6px; }
    .hero-nav-btn { background: none; border: 1px solid var(--border); width: 26px; height: 26px; cursor: pointer; color: var(--fg-mid); font-size: 11px; display: flex; align-items: center; justify-content: center; transition: border-color 0.2s, color 0.2s; }
    .hero-nav-btn:hover { border-color: var(--fg); color: var(--fg); }
    .hero-content.fading { opacity: 0; transition: opacity 0.35s ease; }

    /* Articles section */
    .articles-section { margin-bottom: 64px; }
    .articles-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--fg); }
    .articles-title { font-family: var(--sans); font-size: 15px; font-weight: 500; letter-spacing: 0.05em; color: var(--fg); }
    .articles-more { font-size: 12px; color: var(--fg-mid); letter-spacing: 0.04em; display: flex; align-items: center; gap: 6px; transition: color 0.2s; }
    .articles-more:hover { color: var(--fg); }
    .articles-more::after { content: '→'; font-size: 14px; }
    .articles-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-left: 1px solid var(--border); border-top: 1px solid var(--border); }
    .article-card { display: grid; grid-template-columns: 140px 1fr; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); cursor: pointer; transition: background 0.2s; position: relative; overflow: hidden; text-decoration: none; }
    .article-card:hover { background: #f4f2ee; }
    [data-theme="dark"] .article-card:hover { background: #1a1917; }
    .article-card-image { overflow: hidden; }
    .article-card.has-img { grid-template-columns: 1fr; }
    .article-card.has-img .article-card-image { aspect-ratio: 16/9; width: 100%; }
    .article-card.has-img:hover .article-card-image img { transform: scale(1.03); transition: transform 0.4s ease; }
    .article-card.has-img .article-card-image img { transition: transform 0.4s ease; }
    .card-img-placeholder { width: 140px; height: 100%; min-height: 170px; background: repeating-linear-gradient(-45deg, #c8c6c2 0px, #c8c6c2 1px, #d4d2ce 1px, #d4d2ce 6px); display: flex; align-items: flex-end; padding: 8px; transition: transform 0.4s ease; flex-shrink: 0; }
    [data-theme="dark"] .card-img-placeholder { background: repeating-linear-gradient(-45deg, #2a2826 0px, #2a2826 1px, #222120 1px, #222120 6px); }
    .card-img-placeholder span { font-size: 8px; font-family: monospace; color: #aaa; }
    .article-card-body { padding: 20px 22px; display: flex; flex-direction: column; justify-content: space-between; }
    .card-category { font-size: 10px; letter-spacing: 0.08em; color: var(--fg-light); margin-bottom: 6px; }
    .card-title { font-family: var(--serif); font-size: 17px; font-weight: 500; line-height: 1.6; color: var(--fg); margin-bottom: 10px; letter-spacing: 0.02em; }
    .card-excerpt { font-size: 11.5px; color: var(--fg-mid); line-height: 1.85; margin-bottom: 12px; flex: 1; }
    .card-date { font-size: 11px; color: var(--fg-light); letter-spacing: 0.04em; }
    .underline-hover { position: relative; display: inline; }
    .underline-hover::after { content: ''; position: absolute; bottom: -1px; left: 0; width: 0; height: 1px; background: var(--fg); transition: width 0.3s ease; }
    .article-card:hover .underline-hover::after { width: 100%; }

    /* Modal */
    .article-modal { position: fixed; inset: 0; background: rgba(26,25,23,0.7); z-index: 300; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
    .article-modal.active { opacity: 1; pointer-events: all; }
    .modal-inner { background: var(--bg); width: 680px; max-width: 92vw; max-height: 88vh; overflow-y: auto; padding: 52px 56px; position: relative; transform: translateY(16px); transition: transform 0.3s; }
    .article-modal.active .modal-inner { transform: translateY(0); }
    .modal-close { position: absolute; top: 20px; right: 24px; background: none; border: none; cursor: pointer; font-size: 22px; color: var(--fg-mid); transition: color 0.2s; }
    .modal-close:hover { color: var(--fg); }
    .modal-category { font-size: 11px; letter-spacing: 0.1em; color: var(--fg-light); margin-bottom: 16px; }
    .modal-title { font-family: var(--serif); font-size: 30px; font-weight: 500; line-height: 1.55; margin-bottom: 24px; letter-spacing: 0.02em; }
    .modal-img-placeholder { width: 100%; height: 240px; background: repeating-linear-gradient(-45deg, #2a2826 0px, #2a2826 1px, #1c1b19 1px, #1c1b19 8px); display: flex; align-items: flex-end; justify-content: flex-start; padding: 12px; margin-bottom: 28px; }
    .modal-img-placeholder span { font-size: 9px; font-family: monospace; color: #666; }
    .modal-body p { font-size: 14px; color: var(--fg-mid); line-height: 2; margin-bottom: 16px; }
    .modal-date { font-size: 12px; color: var(--fg-light); margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--border-light); }

    @media (max-width: 768px) {
      .site-main { padding: 0 20px; }
      .hero-inner { grid-template-columns: 1fr; }
      .hero-image { min-height: 200px; }
      .hero-img-placeholder { min-height: 200px; }
      .hero-text { padding: 28px 20px; }
      .hero-title { font-size: 22px; }
      .articles-grid { grid-template-columns: 1fr; }
      .hero-label-vertical { display: none; }
    }
  </style>

  <!-- Article Modal -->
  <div class="article-modal" id="articleModal">
    <div class="modal-inner">
      <button class="modal-close" id="modalClose">✕</button>
      <div class="modal-category" id="modalCategory"></div>
      <h2 class="modal-title" id="modalTitle"></h2>
      <div class="modal-img-placeholder"><span id="modalImgLabel"></span></div>
      <div class="modal-body" id="modalBody"></div>
      <div class="modal-date" id="modalDate"></div>
    </div>
  </div>

  <main class="site-main">
    <!-- Hero -->
    <section class="hero-section fade-in" id="heroCard">
      <div class="hero-inner">
        <div class="hero-image">
          <div class="hero-img-placeholder" id="heroImg">
            <span id="heroImgLabel"></span>
          </div>
        </div>
        <div class="hero-text hero-content" id="heroContent">
          <div class="hero-category" id="heroCategory"></div>
          <h1 class="hero-title" id="heroTitle"></h1>
          <p class="hero-excerpt" id="heroExcerpt"></p>
          <div class="hero-meta">
            <span class="hero-date" id="heroDate"></span>
            <div style="display:flex;align-items:center;gap:14px;">
              <div class="hero-dots" id="heroDots"></div>
              <div class="hero-nav">
                <button class="hero-nav-btn" id="heroPrev">←</button>
                <button class="hero-nav-btn" id="heroNext">→</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-label-vertical">
        <span class="hero-label-text">LATEST ARTICLE</span>
        <div class="hero-label-line"></div>
        <span class="hero-label-num" id="heroNum">01</span>
      </div>
    </section>

    <!-- Articles -->
    <section class="articles-section">
      <div class="articles-header">
        <h2 class="articles-title">新着記事</h2>
        <a href="/essays" class="articles-more">すべての記事を見る</a>
      </div>
      <div class="articles-grid" id="articlesGrid"></div>
    </section>
  </main>

  <script define:vars={{ articles }}>
    // articles injected from Astro content collection via define:vars

    // Hero carousel
    const HERO_COUNT = Math.min(3, articles.length);
    let heroIdx = 0;
    let heroTimer = null;

    const heroDotsEl = document.getElementById('heroDots');
    for (let i = 0; i < HERO_COUNT; i++) {
      const dot = document.createElement('button');
      dot.className = 'hero-dot' + (i === 0 ? ' active' : '');
      dot.addEventListener('click', (e) => { e.stopPropagation(); goHero(i); });
      heroDotsEl.appendChild(dot);
    }

    function renderHero(idx, animate) {
      const a = articles[idx];
      const content = document.getElementById('heroContent');
      const doRender = () => {
        const heroImgEl = document.getElementById('heroImg');
        if (a.img) {
          heroImgEl.style.backgroundImage = `url('${a.img}')`;
          heroImgEl.style.backgroundSize = 'cover';
          heroImgEl.style.backgroundPosition = 'center';
          document.getElementById('heroImgLabel').textContent = '';
        } else {
          heroImgEl.style.backgroundImage = '';
          document.getElementById('heroImgLabel').textContent = a.imgLabel || '';
        }
        document.getElementById('heroCategory').textContent = a.category;
        document.getElementById('heroTitle').textContent = a.title;
        document.getElementById('heroExcerpt').textContent = a.excerpt;
        document.getElementById('heroDate').textContent = a.date;
        document.getElementById('heroNum').textContent = String(idx + 1).padStart(2, '0');
        heroDotsEl.querySelectorAll('.hero-dot').forEach((d, i) => d.classList.toggle('active', i === idx));
        if (animate) content.classList.remove('fading');
      };
      if (animate) {
        content.classList.add('fading');
        setTimeout(doRender, 350);
      } else {
        doRender();
      }
    }

    function goHero(idx) {
      heroIdx = ((idx % HERO_COUNT) + HERO_COUNT) % HERO_COUNT;
      renderHero(heroIdx, true);
      resetHeroTimer();
    }

    function resetHeroTimer() {
      if (heroTimer) clearInterval(heroTimer);
      heroTimer = setInterval(() => goHero(heroIdx + 1), 6000);
    }

    document.getElementById('heroPrev')?.addEventListener('click', (e) => { e.stopPropagation(); goHero(heroIdx - 1); });
    document.getElementById('heroNext')?.addEventListener('click', (e) => { e.stopPropagation(); goHero(heroIdx + 1); });

    const heroCard = document.getElementById('heroCard');
    heroCard.addEventListener('mouseenter', () => { if (heroTimer) clearInterval(heroTimer); });
    heroCard.addEventListener('mouseleave', resetHeroTimer);
    heroCard.addEventListener('click', () => { location.href = articles[heroIdx].href; });

    renderHero(0, false);
    resetHeroTimer();

    // Render article cards
    const grid = document.getElementById('articlesGrid');
    articles.forEach((article, i) => {
      const card = document.createElement('a');
      card.className = 'article-card fade-in' + (article.img ? ' has-img' : '');
      card.href = article.href;
      card.dataset.article = String(i);
      card.innerHTML = `
        <div class="article-card-image">
          ${article.img
            ? `<img src="${article.img}" alt="${article.title}" style="width:100%;height:100%;object-fit:cover;display:block;">`
            : `<div class="card-img-placeholder"><span>${article.imgLabel || ''}</span></div>`}
        </div>
        <div class="article-card-body">
          <div>
            <div class="card-category">${article.category}</div>
            <h3 class="card-title"><span class="underline-hover">${article.title}</span></h3>
            <p class="card-excerpt">${article.excerpt}</p>
          </div>
          <div class="card-date">${article.date}</div>
        </div>
      `;
      grid.appendChild(card);
    });

    // Modal
    const modal = document.getElementById('articleModal');
    const modalClose = document.getElementById('modalClose');

    function closeModal() {
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }

    modalClose.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

    // Scroll fade-in
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
  </script>
</BaseLayout>
